# Lokaal draaien: docker compose up -d, daarna uv run uvicorn app.main:app --reload
DATABASE_URL=postgresql+psycopg://livescoring:livescoring@localhost:5434/livescoring
SECRET_KEY=verzin-hier-iets-lang-en-willekeurigs
BASE_URL=http://localhost:8000
COOKIE_SECURE=false

# Alleen nodig bij het bijwerken van een database van voor de accounts: het adres dat
# eigenaar wordt van de wedstrijden die er nog geen hebben. Daarna mag hij weg.
OWNER_EMAIL=

# Bevestigingsmail na het tekenen. Laat BREVO_API_KEY leeg en er wordt niets verstuurd.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Wedstrijdleiding
